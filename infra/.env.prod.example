# Plantilla de variables de entorno para producción en AWS EC2.
# Copia este archivo a `infra/.env.prod` (ignorado por Git) y completa cada valor.
# Nunca subas `infra/.env.prod` al repositorio ni lo compartas por chat.

# --- Dominio público (sin https:// ni barra final) ---
# Ejemplos: civic-arequipa.duckdns.org  o  3-14-15-92.sslip.io
PHX_HOST=

# --- PostgreSQL + PostGIS (usa `openssl rand -hex 24` para evitar caracteres especiales en la URL) ---
POSTGRES_DB=civic_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_APP_USER=civic_app
POSTGRES_APP_PASSWORD=

# --- Secreto de sesión Phoenix (`openssl rand -base64 48`) ---
SECRET_KEY_BASE=

# --- Claves HMAC de privacidad: 3 claves DISTINTAS (`openssl rand -base64 32` tres veces) ---
# Respáldalas fuera de la EC2 y aparte de la base de datos.
CIVIC_KEY_VERIF_V1=
CIVIC_KEY_REP_V1=
CIVIC_KEY_VOTE_V1=

# --- Ajustes opcionales para el piloto / demostración (descomentar solo si hace falta) ---
# CIVIC_CUPO_SIN_VERIFICAR=3
# CIVIC_CUPO_VERIFICADO=10
# CIVIC_VOTE_THRESHOLD=3
# CIVIC_VOTE_RADIUS_M=1000
# POOL_SIZE=10
